diff --git a/tests/unit/listmodels-nonblocking.spec.ts b/tests/unit/listmodels-nonblocking.spec.ts
new file mode 100644
index 0000000..5b9c0a2
--- /dev/null
+++ b/tests/unit/listmodels-nonblocking.spec.ts
@@ -0,0 +1,178 @@
+import { describe, expect, it } from 'vitest'
+import { credentialRef } from '@deepseek-ai/dsh-credentials'
+
+import { CodeArtsAdapter } from '../../src/llm-adapter.js'
+import { BuddyAdapter } from '../../src/buddy-adapter.js'
+import { CODEBUDDY } from '../../src/product.js'
+import { LobsteraiAdapter } from '../../src/lobsterai-adapter.js'
+import { LOBSTERAI } from '../../src/lobsterai-product.js'
+import { TraeAdapter } from '../../src/trae-adapter.js'
+import { TRAE } from '../../src/trae-product.js'
+import { ZcodeAdapter } from '../../src/zcode-adapter.js'
+import { ZCODE } from '../../src/zcode-product.js'
+import { RaccoonAdapter } from '../../src/raccoon-adapter.js'
+import { RACCOON } from '../../src/raccoon-product.js'
+import { LoomyAdapter } from '../../src/loomy-adapter.js'
+import { LOOMY } from '../../src/loomy-product.js'
+import { ClineAdapter } from '../../src/cline-adapter.js'
+import { CLINE } from '../../src/cline-product.js'
+import { QoderAdapter } from '../../src/qoder-adapter.js'
+import { QODER } from '../../src/qoder-product.js'
+import { AntigravityAdapter } from '../../src/antigravity-adapter.js'
+import { AntigravityLocalAdapter } from '../../src/antigravity-local-adapter.js'
+
+/**
+ * **行为证明：`listModels()` 不得等待网络**（真实性能缺陷的回归锁）。
+ *
+ * ## 缺陷
+ *
+ * 用户报障「装了 JetHub 后，会话框右下角的模型选择器要加载很久才出来」。
+ * 根因是多个适配器在 `listModels()`（模型选择器的 UI 热路径）里**同步 await
+ * 网络**，而 DSH 逐个 provider 收集目录 ⇒ 首帧耗时 = 所有 provider 的网络
+ * 往返之和。
+ *
+ * ## 判据（机制性，不是时间性的）
+ *
+ * 把每个适配器的远端拉取换成**永不 settle** 的 Promise：
+ *
+ * - **修复前**：`listModels()` 里有 `await`，那个 Promise 永不 resolve
+ *   ⇒ 本用例**必然超时**（vitest 的 5 秒），不是「变慢」而是「永不返回」。
+ * - **修复后**：只读缓存 ⇒ 立即返回兜底目录。
+ *
+ * 故「耗时 < 50ms」这个阈值不依赖机器快慢：50ms 对本地内存读取是千倍余量，
+ * 对任何真实网络往返都不够。**已做反向验证** —— 把任何一个适配器改回
+ * `await`，对应用例立刻从毫秒级变成超时失败。
+ *
+ * ⚠ 这里刻意用**真实适配器类**（不是桩）：本文件要防的正是「有人后来给某个
+ * 适配器的 `listModels` 加回一个 `await`」，而那只会在真实实现里发生。
+ */
+
+/** 永不 settle 的 Promise —— 任何 `await` 到它的代码都会永久挂起。 */
+const never = <T,>(): Promise<T> => new Promise<T>(() => {})
+
+/** 本地内存读取的合理上限；真实网络往返远超它。 */
+const BUDGET_MS = 50
+
+const base = {
+  credentialRef: credentialRef('LISTMODELS_PROBE_ACCOUNT'),
+  resolveCredential: async () => undefined,
+  refresh: async () => {},
+}
+
+/**
+ * 11 个适配器与它们「永不返回」的远端拉取入口。
+ *
+ * ⚠ 新增 provider 时**必须**在这里补一行 —— 这是「listModels 不许等网络」
+ * 这条契约的唯一系统性守卫。
+ */
+const cases: Array<{
+  name: string
+  make: () => { listModels(provider: string): Promise<readonly unknown[]>; provider: string }
+}> = [
+  {
+    name: 'codearts',
+    make: () => {
+      const adapter = new CodeArtsAdapter({ ...base, fetchRemoteModels: () => never() })
+      return { listModels: (p) => adapter.listModels(p), provider: 'codearts' }
+    },
+  },
+  {
+    name: 'buddy',
+    make: () => {
+      const adapter = new BuddyAdapter({ ...base, product: CODEBUDDY, fetchRemoteModels: () => never() })
+      return { listModels: (p) => adapter.listModels(p), provider: CODEBUDDY.id }
+    },
+  },
+  {
+    name: 'lobsterai',
+    make: () => {
+      const adapter = new LobsteraiAdapter({ ...base, product: LOBSTERAI, fetchRemoteModels: () => never() })
+      return { listModels: (p) => adapter.listModels(p), provider: LOBSTERAI.id }
+    },
+  },
+  {
+    name: 'trae',
+    make: () => {
+      const adapter = new TraeAdapter({ ...base, product: TRAE, fetchRemoteModels: () => never() })
+      return { listModels: (p) => adapter.listModels(p), provider: TRAE.id }
+    },
+  },
+  {
+    name: 'zcode',
+    make: () => {
+      const adapter = new ZcodeAdapter({ ...base, product: ZCODE, fetchRemoteModels: () => never() })
+      return { listModels: (p) => adapter.listModels(p), provider: ZCODE.id }
+    },
+  },
+  {
+    name: 'raccoon',
+    make: () => {
+      const adapter = new RaccoonAdapter({ ...base, product: RACCOON, fetchRemoteModels: () => never() })
+      return { listModels: (p) => adapter.listModels(p), provider: RACCOON.id }
+    },
+  },
+  {
+    name: 'loomy',
+    make: () => {
+      const adapter = new LoomyAdapter({ ...base, product: LOOMY, fetchRemoteModels: () => never() })
+      return { listModels: (p) => adapter.listModels(p), provider: LOOMY.id }
+    },
+  },
+  {
+    name: 'cline',
+    make: () => {
+      // cline 的拉取入口是 `loadModels`（返回 models + warnings）。
+      const adapter = new ClineAdapter({ ...base, product: CLINE, loadModels: () => never() })
+      return { listModels: (p) => adapter.listModels(p), provider: CLINE.id }
+    },
+  },
+  {
+    name: 'qoder（静态目录）',
+    make: () => {
+      const adapter = new QoderAdapter({ ...base, product: QODER })
+      return { listModels: (p) => adapter.listModels(p), provider: QODER.id }
+    },
+  },
+  {
+    name: 'antigravity（公版）',
+    make: () => {
+      const adapter = new AntigravityAdapter({
+        readCredential: () => undefined,
+        fetchImpl: (() => never()) as unknown as typeof fetch,
+      })
+      return { listModels: (p) => adapter.listModels(p), provider: 'antigravity' }
+    },
+  },
+  {
+    name: 'antigravity-local',
+    make: () => {
+      const adapter = new AntigravityLocalAdapter({
+        // 实例发现永不返回：修复前 listModels 会 await 它。
+        discover: () => never(),
+        fetchImpl: (() => never()) as unknown as typeof fetch,
+        allowPublicFallback: false,
+      })
+      return { listModels: (p) => adapter.listModels(p), provider: 'antigravity' }
+    },
+  },
+]
+
+describe('listModels 不得等待网络（首帧非阻塞）', () => {
+  for (const testCase of cases) {
+    it(`${testCase.name}：远端永不返回时 listModels 仍在 ${BUDGET_MS}ms 内返回`, async () => {
+      const { listModels, provider } = testCase.make()
+      const started = Date.now()
+      const models = await listModels(provider)
+      const elapsed = Date.now() - started
+      // 目录必须仍然可用（回退兜底表）—— 非阻塞不等于返回空。
+      expect(models.length).toBeGreaterThan(0)
+      expect(elapsed).toBeLessThan(BUDGET_MS)
+    })
+  }
+
+  it('覆盖全部适配器（新增 provider 时别忘了往 cases 里补一行）', () => {
+    // 这条断言的作用是「提醒」而非穷举：新增适配器若忘了登记，
+    // 它就不受「listModels 不许等网络」这条契约保护。
+    expect(cases.length).toBeGreaterThanOrEqual(11)
+  })
+})

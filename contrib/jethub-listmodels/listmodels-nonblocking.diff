+import { describe, expect, it, vi } from 'vitest'
+import { CatalogRefresh, FAILURE_COOLDOWN_MS, sameCatalog } from '../../src/catalog-refresh.js'
+
+/**
+ * `CatalogRefresh` 的单测。
+ *
+ * 这是「`listModels()` 非阻塞化」这个修复的核心部件，故在这里把它的四条
+ * 关键契约逐条锁死：**同步返回**、**并发去重**、**变化才广播**、
+ * **失败冷却**。任何一条被改坏都会让那个性能缺陷复发或引入新缺陷。
+ */
+
+/** 造一个可控的拉取：手动决定何时 resolve。 */
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  let reject!: (error: unknown) => void
+  const promise = new Promise<T>((res, rej) => { resolve = res; reject = rej })
+  return { promise, resolve, reject }
+}
+
+const models = (...ids: string[]) => ids.map((id) => ({ id, name: id.toUpperCase() }))
+
+describe('CatalogRefresh.start', () => {
+  it('同步返回：即使拉取永不 resolve，也不阻塞调用方', () => {
+    const never = deferred<ReturnType<typeof models>>()
+    const refresh = new CatalogRefresh(() => never.promise)
+    const started = Date.now()
+    refresh.start()
+    // 本方法**不返回 Promise**（TypeScript 层面就杜绝了 await 的可能）。
+    expect(refresh.start()).toBeUndefined()
+    expect(Date.now() - started).toBeLessThan(20)
+    expect(refresh.get()).toBeUndefined()
+  })
+
+  it('落地后 get() 能读到结果', async () => {
+    const refresh = new CatalogRefresh(async () => models('a', 'b'))
+    refresh.start()
+    await refresh.settled()
+    expect(refresh.get()?.map((m) => m.id)).toEqual(['a', 'b'])
+  })
+
+  it('并发去重：进行中时重复 start 不会打出第二次拉取', async () => {
+    const d = deferred<ReturnType<typeof models>>()
+    const fetch = vi.fn(() => d.promise)
+    const refresh = new CatalogRefresh(fetch)
+    refresh.start()
+    refresh.start()
+    refresh.start()
+    expect(fetch).toHaveBeenCalledTimes(1)
+    d.resolve(models('a'))
+    await refresh.settled()
+    expect(fetch).toHaveBeenCalledTimes(1)
+  })
+
+  it('已有缓存时不再重复拉取', async () => {
+    const fetch = vi.fn(async () => models('a'))
+    const refresh = new CatalogRefresh(fetch)
+    refresh.start()
+    await refresh.settled()
+    refresh.start()
+    await refresh.settled()
+    expect(fetch).toHaveBeenCalledTimes(1)
+  })
+
+  it('force 时忽略缓存强制重拉', async () => {
+    const fetch = vi.fn(async () => models('a'))
+    const refresh = new CatalogRefresh(fetch)
+    refresh.start()
+    await refresh.settled()
+    refresh.start({ force: true })
+    await refresh.settled()
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+})
+
+describe('CatalogRefresh 失败冷却（防热路径请求风暴）', () => {  it('拉取抛错后，冷却期内重复 start 不再发请求', async () => {
+    const fetch = vi.fn(async () => { throw new Error('boom') })
+    const refresh = new CatalogRefresh(fetch)
+    refresh.start()
+    await refresh.settled()
+    // 模拟「用户在冷却期内反复打开模型选择器」。
+    for (let i = 0; i < 10; i++) {
+      refresh.start()
+      await refresh.settled()
+    }
+    expect(fetch).toHaveBeenCalledTimes(1)
+  })
+
+  it('远端回空数组同样进入冷却（否则热路径每次都要打一次网络）', async () => {
+    const fetch = vi.fn(async () => [])
+    const refresh = new CatalogRefresh(
+      fetch as unknown as () => Promise<Array<{ id: string; name: string }>>,
+      undefined,
+      (value) => value.length > 0,
+    )
+    refresh.start()
+    await refresh.settled()
+    for (let i = 0; i < 5; i++) {
+      refresh.start()
+      await refresh.settled()
+    }
+    expect(fetch).toHaveBeenCalledTimes(1)
+  })
+
+  it('冷却结束后允许重试（用注入的时钟跳过等待）', async () => {
+    let clock = 0
+    const fetch = vi.fn(async () => { throw new Error('boom') })
+    const refresh = new CatalogRefresh(fetch, undefined, () => true, () => clock)
+    refresh.start()
+    await refresh.settled()
+    expect(fetch).toHaveBeenCalledTimes(1)
+    // 冷却未过：不重试。
+    clock = FAILURE_COOLDOWN_MS - 1
+    refresh.start()
+    await refresh.settled()
+    expect(fetch).toHaveBeenCalledTimes(1)
+    // 冷却已过：重试。
+    clock = FAILURE_COOLDOWN_MS
+    refresh.start()
+    await refresh.settled()
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+
+  it('invalidate 清除缓存与冷却（账号切换后要能立刻重拉）', async () => {
+    let clock = 0
+    const fetch = vi.fn(async () => { throw new Error('boom') })
+    const refresh = new CatalogRefresh(fetch, undefined, () => true, () => clock)
+    refresh.start()
+    await refresh.settled()
+    refresh.invalidate()
+    refresh.start()
+    await refresh.settled()
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+})
+
+describe('CatalogRefresh 变化广播', () => {
+  it('首次落地即广播（「兜底表 → 远端目录」那一次必须通知）', async () => {
+    const onChanged = vi.fn()
+    const refresh = new CatalogRefresh(async () => models('a'), onChanged)
+    refresh.start()
+    await refresh.settled()
+    expect(onChanged).toHaveBeenCalledTimes(1)
+  })
+
+  it('内容相同的重复刷新**不**广播（避免选择器无谓重读）', async () => {
+    const onChanged = vi.fn()
+    const refresh = new CatalogRefresh(async () => models('a', 'b'), onChanged)
+    refresh.start()
+    await refresh.settled()
+    refresh.start({ force: true })
+    await refresh.settled()
+    expect(onChanged).toHaveBeenCalledTimes(1)
+  })
+
+  it('内容真的变了才再广播一次', async () => {
+    const onChanged = vi.fn()
+    let payload = models('a')
+    const refresh = new CatalogRefresh(async () => payload, onChanged)
+    refresh.start()
+    await refresh.settled()
+    payload = models('a', 'b')
+    refresh.start({ force: true })
+    await refresh.settled()
+    expect(onChanged).toHaveBeenCalledTimes(2)
+  })
+
+  it('名称变化也算「变了」（展示名/倍率会进 name）', async () => {
+    const onChanged = vi.fn()
+    let payload = [{ id: 'a', name: 'A' }]
+    const refresh = new CatalogRefresh(async () => payload, onChanged)
+    refresh.start()
+    await refresh.settled()
+    payload = [{ id: 'a', name: 'A · x0.5' }]
+    refresh.start({ force: true })
+    await refresh.settled()
+    expect(onChanged).toHaveBeenCalledTimes(2)
+  })
+})
+
+describe('sameCatalog', () => {
+  it('长度不同即不同', () => {
+    expect(sameCatalog([{ id: 'a', name: 'A' }], [])).toBe(false)
+  })
+
+  it('id 或 name 不同即不同', () => {
+    expect(sameCatalog([{ id: 'a', name: 'A' }], [{ id: 'b', name: 'A' }])).toBe(false)
+    expect(sameCatalog([{ id: 'a', name: 'A' }], [{ id: 'a', name: 'B' }])).toBe(false)
+  })
+
+  it('逐项相同即相同（与引用无关）', () => {
+    expect(sameCatalog([{ id: 'a', name: 'A' }], [{ id: 'a', name: 'A' }])).toBe(true)
+  })
+})
+
+describe('回归：同步抛错的 fetch 不得让 settled() 死锁', () => {
+  /**
+   * **真实缺陷**（写本模块时实测踩到，把一次测试跑变成无限挂起）：
+   *
+   * `start()` 早先写成 `this.loading = this.run()`，而 `run()` 是 async 函数
+   * —— 它可能在**第一个 await 之前**就同步跑完（例如 `fetch()` 同步抛错，
+   * 那正是 `fetchRemoteModels` 未注入时的情形）。执行顺序于是变成：
+   *
+   *   ① 调 `run()` → 同步走到 `finally`，把 `this.loading` 设为 undefined
+   *   ② **然后**赋值语句才把 `this.loading` 写回那个已 settle 的 Promise
+   *
+   * ⇒ `loading` 永远非 undefined ⇒ `settled()` 的 while **死锁**。
+   *
+   * 下面两条用例用 `Promise.race` 加超时把「死锁」变成「可读的失败」，
+   * 否则挂起只会表现为 vitest 整体超时，极难定位。
+   */
+  it('fetch 同步抛错时 settled() 仍能返回', async () => {
+    const refresh = new CatalogRefresh<Array<{ id: string; name: string }>>(() => {
+      throw new Error('sync boom')
+    })
+    refresh.start()
+    await expect(Promise.race([
+      refresh.settled(),
+      new Promise((_, reject) => setTimeout(() => reject(new Error('settled 死锁')), 1_000)),
+    ])).resolves.toBeUndefined()
+  })
+
+  it('fetch 返回已 resolve 的值时 settled() 仍能返回', async () => {
+    const refresh = new CatalogRefresh(async () => models('a'))
+    refresh.start()
+    await expect(Promise.race([
+      refresh.settled(),
+      new Promise((_, reject) => setTimeout(() => reject(new Error('settled 死锁')), 1_000)),
+    ])).resolves.toBeUndefined()
+    expect(refresh.get()?.map((m) => m.id)).toEqual(['a'])
+  })
+
+  it('同步失败后 repeatedly start/settled 不累积（冷却生效且不死锁）', async () => {
+    let calls = 0
+    const refresh = new CatalogRefresh<Array<{ id: string; name: string }>>(() => {
+      calls++
+      throw new Error('sync boom')
+    })
+    for (let i = 0; i < 5; i++) {
+      refresh.start()
+      await refresh.settled()
+    }
+    // 冷却期内的重复 start 不重试。
+    expect(calls).toBe(1)
+  })
+})

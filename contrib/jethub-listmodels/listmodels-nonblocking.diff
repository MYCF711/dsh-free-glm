+  if (a === b) return true
+  if (a.length !== b.length) return false
+  for (let i = 0; i < a.length; i++) {
+    const left = a[i] as { id?: unknown; name?: unknown } | null | undefined
+    const right = b[i] as { id?: unknown; name?: unknown } | null | undefined
+    if (left?.id !== right?.id) return false
+    if (left?.name !== right?.name) return false
+  }
+  return true
+}

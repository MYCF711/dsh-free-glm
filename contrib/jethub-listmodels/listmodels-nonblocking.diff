+        // 否则热路径下次调用又会立刻重试（见 `retryAt` 的说明）。
+        this.retryAt = this.now() + FAILURE_COOLDOWN_MS
+        return
+      }
+      const changed = !this.sameAs(this.lastBroadcast, fetched)
+      this.value = fetched
+      // 成功即清除冷却。
+      this.retryAt = 0
+      // ⚠ 只在**渲染出去的目录真的变了**时广播：无差别广播会让每一轮后台
+      // 刷新都触发选择器重读。首帧（`lastBroadcast === undefined`）必定算变化，
+      // 这正是「兜底表 → 远端目录」那一次必须通知的场景。
+      if (changed) {

# 依赖
node_modules/

# 构建产物（发布走 tgz，不入库）
lib/

# 打包产物
*.tgz
# 例外：releases/ 下的发布 tgz 要入库 ——
# 使用者克隆后可直接 `dsh plugin add file:<repo>/releases/xxx.tgz`，
# 无需自行构建（构建需完整开源版源码 + 10-40 分钟）。
!releases/*.tgz

# 临时/调试脚本
test-adapter.mjs
test-apply.mjs

# 编辑器
.vscode/
.idea/

# 系统
Thumbs.db
.DS_Store

# 日志与备份（排查过程留下的）
*.bak-*
*.log

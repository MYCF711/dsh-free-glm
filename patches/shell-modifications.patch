+                    "Bash",
+                    // 文件写
+                    "Write",
+                    "Edit",
+                    "ApplyPatch",
+                    // agent / 工作流（会产生长任务）
+                    "Agent",
+                    "Task",
+                    "CreateWorkflow",
+                    "AmendWorkflow",
+                    "submit_result",
+                    // node repl
+                    "js",
+                    "js_reset",
+                    "js_add_node_module_dir",
+                    "mcp__node_repl__js",
+                    "mcp__node_repl__js_reset",
+                    "mcp__node_repl__js_add_node_module_dir",
+                    // 会阻塞等人的交互工具
+                    "AskUserQuestion",

+                  content: typeof m.content,
+                  tools: Array.isArray(m.tools) ? (m.tools as unknown[]).length : typeof m.tools,
+                  parts: Array.isArray(m.parts) ? (m.parts as unknown[]).length : typeof m.parts,
+                  toolsSample:
